# Bek-Chat Environment Configuration Template

# Node Environment
NODE_ENV=production
PORT=3000

# PostgreSQL Database Creds
POSTGRES_USER=bek_user
POSTGRES_PASSWORD=bek_password
POSTGRES_DB=bek_chat
DATABASE_URL=postgresql://bek_user:bek_password@localhost:5432/bek_chat?schema=public

# Redis Config (Pub/Sub & Socket.IO horizontal scaling)
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication & JWT Secrets
JWT_SECRET=super-secret-jwt-key-change-in-prod-environment-32chars
